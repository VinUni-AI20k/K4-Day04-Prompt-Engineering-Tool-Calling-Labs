{
  "dataset_id": "day04_v3_helpdesk_group",
  "dataset_role": "group",
  "description": "Ten original team-authored IT helpdesk cases: 5 single-turn query cases and 5 multi-turn cases.",
  "allowed_failure_types": [
    "wrong_tool",
    "wrong_arg_value",
    "wrong_boundary",
    "unnecessary_tool",
    "out_of_scope",
    "missing_info"
  ],
  "cases": [
    {
      "id": "G01_meeting_room_kb",
      "phase": "B",
      "suite": "group",
      "query": "Tìm hướng dẫn xử lý lỗi âm thanh trong phòng họp, chỉ lấy tối đa 2 kết quả.",
      "failure_type": "wrong_arg_value",
      "expect": {
        "tool_calls": [
          {
            "name": "search_kb",
            "args": {
              "category": "meeting_room",
              "top_k": 2
            }
          }
        ]
      },
      "metadata": {
        "skill": "kb_category_and_limit",
        "difficulty": "medium",
        "what_it_tests": "Phân biệt sự cố phòng họp với audio trên thiết bị cá nhân và truyền đúng giới hạn kết quả."
      }
    },
    {
      "id": "G02_staging_printing_status",
      "phase": "B",
      "suite": "group",
      "query": "Dịch vụ in ở staging hiện có đang gián đoạn không?",
      "failure_type": "wrong_arg_value",
      "expect": {
        "tool_calls": [
          {
            "name": "check_service_status",
            "args": {
              "service": "printing",
              "environment": "staging"
            }
          }
        ]
      },
      "metadata": {
        "skill": "service_and_environment",
        "difficulty": "medium",
        "what_it_tests": "Trích đúng printing và giữ staging thay vì dùng production mặc định."
      }
    },
    {
      "id": "G03_external_tools_policy",
      "phase": "B",
      "suite": "group",
      "query": "Theo chính sách nội bộ, nhân viên có được tải log chẩn đoán lên một công cụ AI bên ngoài không?",
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "policy",
            "args": {
              "policy_area": "external_tools"
            }
          }
        ]
      },
      "metadata": {
        "skill": "external_tools_policy",
        "difficulty": "medium",
        "what_it_tests": "Câu hỏi về việc dùng công cụ bên ngoài phải tra policy, không gọi search web hoặc inspect device."
      }
    },
    {
      "id": "G04_public_compatibility_search",
      "phase": "B",
      "suite": "group",
      "query": "Tìm thông tin tương thích docking station chính hãng cho Dell Latitude 7440, tối đa 5 kết quả.",
      "failure_type": "wrong_arg_value",
      "expect": {
        "tool_calls": [
          {
            "name": "search_device_info",
            "args": {
              "manufacturer": "Dell",
              "model": "Latitude 7440",
              "query_type": "compatibility",
              "max_results": 5
            }
          }
        ]
      },
      "metadata": {
        "skill": "public_model_compatibility",
        "difficulty": "hard",
        "what_it_tests": "Dùng external search cho model công khai và chọn đúng query_type compatibility cùng giới hạn tối đa."
      }
    },
    {
      "id": "G05_format_brief_findings",
      "phase": "B",
      "suite": "group",
      "query": "Đã có findings: PR-512 queue stuck, printer reachable=false. Chỉ trình bày thành báo cáo ngắn tên 'PR-512 printing'; không kiểm tra lại.",
      "failure_type": "unnecessary_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "format_incident_report",
            "args": {
              "template": "brief",
              "incident_title": "PR-512 printing"
            }
          }
        ]
      },
      "metadata": {
        "skill": "format_existing_findings",
        "difficulty": "medium",
        "what_it_tests": "Yêu cầu format-only phải bỏ qua các tool thu thập dữ liệu và chọn brief template."
      }
    },
