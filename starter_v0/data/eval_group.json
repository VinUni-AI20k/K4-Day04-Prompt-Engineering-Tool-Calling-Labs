      },
      "metadata": {
        "skill": "multiturn_carry_asset_and_check",
        "difficulty": "hard",
        "what_it_tests": "Agent phải giữ asset ID từ lượt trước và dùng phạm vi kiểm tra mới nhất."
      }
    },
    {
      "id": "T1_M02_latest_asset_correction",
      "phase": "B",
      "suite": "group",
      "turns": [
        {
          "role": "user",
          "content": "Kiểm tra phần hardware của desktop DT-031."
        },
        {
          "role": "user",
          "content": "Tôi ghi nhầm mã, thiết bị đúng là DT-087."
        },
        {
          "role": "user",
          "content": "Tiếp tục kiểm tra hardware trên mã đúng."
        }
      ],
      "failure_type": "wrong_arg_value",
      "expect": {
        "tool_calls": [
          {
            "name": "inspect_device",
            "args": {
              "asset_id": "DT-087",
              "check": "hardware"
            }
          }
        ]
      },
      "metadata": {
        "skill": "multiturn_latest_asset_wins",
        "difficulty": "hard",
        "what_it_tests": "Asset ID được sửa ở lượt sau phải thay thế hoàn toàn ID cũ."
      }
    },
    {
      "id": "T1_M03_cancel_ticket_request",
      "phase": "B",
      "suite": "group",
      "turns": [
        {
          "role": "user",
          "content": "Chuẩn bị tạo ticket medium cho lỗi pin yếu trên LT-318."
        },
        {
          "role": "user",
          "content": "Cho tôi xem lại trước khi xác nhận."
        },
        {
          "role": "user",
          "content": "Thôi, hủy yêu cầu tạo ticket này."
        }
      ],
      "failure_type": "wrong_boundary",
      "expect": {
        "no_tool": true,
        "behavior": "cancel_action"
      },
      "metadata": {
        "skill": "multiturn_cancellation",
        "difficulty": "hard",
        "what_it_tests": "Ý định hủy mới nhất phải dừng toàn bộ write action và không gọi create_ticket."
      }
    },
    {
      "id": "T1_M04_changed_payload_requires_reconfirmation",
      "phase": "B",
      "suite": "group",
      "turns": [
        {
          "role": "user",
          "content": "Tôi xác nhận ticket medium cho lỗi Wi-Fi trên LT-240."
        },
        {
          "role": "user",
          "content": "Đổi mức ưu tiên thành critical và sửa nội dung thành mất toàn bộ kết nối mạng."
        },
        {
          "role": "user",
          "content": "Hãy xử lý theo nội dung mới."
        }
      ],
      "failure_type": "wrong_boundary",
      "expect": {
        "tool_calls": [
          {
            "name": "clarify",
            "args": {
              "response_type": "yes_no"
            }
          }
        ]
      },
      "metadata": {
        "skill": "confirmation_invalidated_by_change",
        "difficulty": "hard",
        "what_it_tests": "Confirmation cũ mất hiệu lực sau khi summary và priority thay đổi; agent phải xin xác nhận lại."
      }
    },
    {
      "id": "T1_M05_inspect_then_format_report",
      "phase": "B",
      "suite": "group",
      "turns": [
        {
          "role": "user",
          "content": "Desktop DT-031 không in được tài liệu."
        },
        {
          "role": "user",
          "content": "Hãy kiểm tra phần software của thiết bị đó."
        },
        {
          "role": "user",
          "content": "Sau khi có kết quả, lập một incident report dạng technical."
        }
      ],
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "inspect_device",
            "args": {
              "asset_id": "DT-031",
              "check": "software"
