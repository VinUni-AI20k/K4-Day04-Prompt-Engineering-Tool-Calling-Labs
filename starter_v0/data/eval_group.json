{
  "dataset_id": "day04_v3_helpdesk_team1",
  "dataset_role": "group",
  "description": "Ten original evaluation cases designed by K4A Day 04 Team 1: five single-turn and five multi-turn IT helpdesk scenarios.",
  "allowed_failure_types": [
    "wrong_tool",
    "wrong_arg_value",
    "wrong_boundary",
    "unnecessary_tool",
    "out_of_scope",
    "missing_info"
  ],
  "cases": [
    {
      "id": "T1_S01_printer_asset_network",
      "phase": "B",
      "suite": "group",
      "query": "Máy in PR-404 đang ngoại tuyến. Hãy kiểm tra riêng tình trạng kết nối mạng của thiết bị này.",
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "inspect_device",
            "args": {
              "asset_id": "PR-404",
              "check": "network"
            }
          }
        ]
      },
      "metadata": {
        "skill": "route_specific_printer_asset",
        "difficulty": "medium",
        "what_it_tests": "Thiết bị máy in có asset ID phải dùng inspect_device, không nhầm với trạng thái dịch vụ printing dùng chung."
      }
    },
    {
      "id": "T1_S02_expired_employee_account",
      "phase": "B",
      "suite": "group",
      "query": "Tra cứu trạng thái tài khoản và danh sách thiết bị được cấp của nhân viên EMP-1009.",
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "lookup_user",
            "args": {
              "employee_id": "EMP-1009"
            }
          }
        ]
      },
      "metadata": {
        "skill": "route_employee_directory",
        "difficulty": "easy",
        "what_it_tests": "Yêu cầu về tài khoản và tài sản được cấp phải dùng lookup_user."
      }
    },
    {
      "id": "T1_S03_meeting_room_audio_guide",
      "phase": "B",
      "suite": "group",
      "query": "Tìm hướng dẫn xử lý khi micro trong phòng họp không thu được âm thanh.",
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "search_kb",
            "args": {
              "category": "meeting_room"
            }
          }
        ]
      },
      "metadata": {
        "skill": "route_meeting_room_howto",
        "difficulty": "medium",
        "what_it_tests": "Yêu cầu hướng dẫn xử lý phải tìm knowledge base thay vì kiểm tra một asset chưa được cung cấp."
      }
    },
    {
      "id": "T1_S04_wifi_floor_outage",
      "phase": "B",
      "suite": "group",
      "query": "Nhiều nhân viên ở tầng 4 Bangkok đều mất Wi-Fi. Kiểm tra trạng thái Wi-Fi production giúp tôi.",
      "failure_type": "wrong_tool",
      "expect": {
        "tool_calls": [
          {
            "name": "check_service_status",
            "args": {
              "service": "wifi",
              "environment": "production"
            }
          }
        ]
      },
      "metadata": {
        "skill": "route_shared_wifi_outage",
        "difficulty": "medium",
        "what_it_tests": "Sự cố ảnh hưởng nhiều người phải dùng shared service status thay vì inspect một thiết bị."
      }
    },
    {
      "id": "T1_S05_ambiguous_qa_environment",
      "phase": "B",
      "suite": "group",
      "query": "Kiểm tra trạng thái email trên môi trường QA giúp tôi.",
      "failure_type": "missing_info",
      "expect": {
        "tool_calls": [
          {
            "name": "clarify",
            "args": {
              "response_type": "choice"
            }
          }
        ]
      },
      "metadata": {
        "skill": "clarify_ambiguous_environment",
        "difficulty": "medium",
        "what_it_tests": "QA không phải environment hợp lệ; agent phải hỏi production hay staging thay vì tự đoán."
      }
    },
    {
