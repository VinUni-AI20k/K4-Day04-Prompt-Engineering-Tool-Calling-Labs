        },
        {
          "role": "user",
          "content": "Chỉ kiểm tra phần security của máy vừa nêu."
        }
      ],
      "failure_type": "wrong_arg_value",
      "expect": {
        "tool_calls": [
          {
            "name": "inspect_device",
            "args": {
              "asset_id": "LT-411",
              "check": "security"
