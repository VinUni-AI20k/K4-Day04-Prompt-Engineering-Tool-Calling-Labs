# Day 04 Lab v3 — IT Helpdesk Agent
# Copy this file to `.env` (same folder) and fill in your keys.
# NEVER commit `.env` — it is gitignored. Keys here are NAMES ONLY (no values).

# --- Model provider (choose ONE; OpenRouter or OpenAI/Compatible recommended) ---

# 1. OpenRouter (OpenRouter API - hỗ trợ nhiều models)
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# 2. OpenAI & OpenAI-Compatible (OpenAI, Groq, DeepSeek, Ollama, vLLM, LM Studio...)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_BASE_URL=http://localhost:11434/v1

# 3. Anthropic Claude
# ANTHROPIC_API_KEY=

# 4. Google Gemini
# GEMINI_API_KEY=

# Helpdesk tools use deterministic local mock data and need no additional keys.

# --- Optional external device search (Tavily) ---
TAVILY_API_KEY=
